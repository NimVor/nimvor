# WhaCP panel configuration (environment-file for the whacp binary).
# Managed by the installer. Owned by root, readable by the whacp group only.
WHACP_LISTEN=127.0.0.1:8090
WHACP_DB_PATH=/var/lib/whacp/whacp.sqlite
WHACP_AGENT_SOCKET=/run/whacp/agent.sock
WHACP_AGENT_TOKEN_FILE=/etc/whacp/agent.token
WHACP_KEY_FILE=/etc/whacp/panel.key
WHACP_LOG_FILE=/var/log/whacp/panel.log
# Set to 1 when a TLS reverse proxy is in front (enables HSTS + Secure cookies).
WHACP_PRODUCTION=0
# Leave WHACP_STATIC unset to serve assets (CSS/JS/fonts) baked into the binary.
# WHACP_STATIC=/usr/share/whacp/assets
