{
  "name": "nimvor-sql-editor",
  "private": true,
  "version": "1.0.0",
  "description": "The SQL editor bundle of the PostgreSQL page (CodeMirror 6). Built by scripts/build-sql-editor.sh into public/assets/vendor/codemirror/.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=../../public/assets/vendor/codemirror/sql-editor.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.4",
    "@codemirror/commands": "6.7.1",
    "@codemirror/lang-sql": "6.8.0",
    "@codemirror/language": "6.10.8",
    "@codemirror/search": "6.5.8",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.36.2",
    "@lezer/highlight": "1.2.5",
    "sql-formatter": "15.4.9"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
