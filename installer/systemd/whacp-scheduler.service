[Unit]
Description=WhaCP scheduler (metrics, alerts, scheduled backups and retention)
Documentation=https://github.com/mchkhawarshahzad/WhaCP/tree/main/docs
After=whacp-agent.service

[Service]
Type=oneshot
User=whacp
Group=whacp
Environment=WHACP_CONFIG=/etc/whacp/panel.php
ExecStart=/usr/bin/php -d display_errors=stderr /opt/whacp/panel/bin/whacp schedule:run
TimeoutStartSec=15min

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/whacp /var/log/whacp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
