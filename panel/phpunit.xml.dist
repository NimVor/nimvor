<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         cacheDirectory="storage/.phpunit.cache">
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
        <testsuite name="http"><directory>tests/Http</directory></testsuite>
        <testsuite name="security"><directory>tests/Security</directory></testsuite>
        <testsuite name="performance"><directory>tests/Performance</directory></testsuite>
    </testsuites>
    <php>
        <!-- The whole suite needs more than the 300 s some PHP builds allow a CLI process (password hashing in every HTTP test). -->
        <ini name="max_execution_time" value="0"/>
    </php>
    <source>
        <include><directory>app</directory></include>
    </source>
</phpunit>
