[Unit]
Description=WhaCP scheduler (automatic SSL and other background work)
Documentation=https://github.com/mchkhawarshahzad/WhaCP/blob/HEAD/docs/installation/README.md
After=whacp-agent.service

[Service]
Type=oneshot
User=whacp
Group=whacp
EnvironmentFile=-/etc/whacp/server.env
ExecStart=/usr/local/bin/whacp schedule:run
TimeoutStartSec=15min

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/whacp /var/log/whacp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
