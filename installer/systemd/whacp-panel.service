[Unit]
Description=WhaCP panel (loopback web interface)
Documentation=https://github.com/mchkhawarshahzad/WhaCP/blob/HEAD/docs/installation/README.md
After=network.target whacp-agent.service
Wants=whacp-agent.service

[Service]
Type=simple
User=whacp
Group=whacp
# EnvironmentFile is optional (-) so the unit still starts if the file is
# temporarily missing; the binary uses built-in defaults for anything unset.
EnvironmentFile=-/etc/whacp/server.env
ExecStart=/usr/local/bin/whacp
ExecStartPre=/usr/local/bin/whacp -version >/dev/null 2>&1 || true
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/whacp /var/log/whacp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
MemoryMax=512M

[Install]
WantedBy=multi-user.target
