[Unit]
Description=NimVor scheduler (metrics, alerts, scheduled backups and retention)
Documentation=https://github.com/NimVor/nimvor/tree/main/docs
After=nimvor-agent.service

[Service]
Type=oneshot
User=nimvor
Group=nimvor
Environment=NIMVOR_CONFIG=/etc/nimvor/panel.php
ExecStart=/usr/bin/php -d display_errors=stderr /opt/nimvor/panel/bin/nimvor schedule:run
TimeoutStartSec=15min

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nimvor /var/log/nimvor
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
