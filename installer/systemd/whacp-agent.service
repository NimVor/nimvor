[Unit]
Description=WhaCP server agent (privileged actions for the WhaCP panel)
Documentation=https://github.com/mchkhawarshahzad/WhaCP/tree/main/docs/agent
After=network.target
# The agent must never take the host down with it.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/whacp-agent -config /etc/whacp/agent.json
ExecStartPre=/usr/local/bin/whacp-agent -config /etc/whacp/agent.json -check-config
Restart=on-failure
RestartSec=3s

# The agent runs as root so it can read configuration owned by other
# services, but with a tightly limited capability set.
User=root
Group=whacp
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=yes
RuntimeDirectory=whacp
RuntimeDirectoryMode=0750

# Read-only discovery release: the whole filesystem is read-only for the
# agent except its own runtime directory. Write actions in later releases
# will widen ReadWritePaths explicitly, one path at a time.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/whacp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

# Resource guard rails.
MemoryMax=256M
TasksMax=64
Nice=5

[Install]
WantedBy=multi-user.target
