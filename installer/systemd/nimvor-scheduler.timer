[Unit]
Description=Run the NimVor scheduler every 5 minutes

[Timer]
# OnActiveSec starts the first run one minute after the timer is enabled: OnBootSec has
# usually passed by then and OnUnitActiveSec only counts from a first run, so without it
# the scheduler would not start until the next reboot.
OnActiveSec=1min
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
