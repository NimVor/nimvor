#!/usr/bin/env bash
# nimvor: the panel's command-line tool without the long command.
#
#   sudo nimvor user:password admin     reset a password (alias: reset-password)
#   sudo nimvor user:2fa-reset admin    turn two-factor off (alias: reset-2fa)
#   sudo nimvor doctor                  check the installation
#   sudo nimvor update                  update to the newest release (with its database migrations)
#   sudo nimvor update --check          say whether a newer release exists, change nothing
#   sudo nimvor help                    every command
#
# Installed as /usr/local/bin/nimvor by installer/install.sh and upgrade.sh.
# It runs the panel's own tool as the panel's account with the panel's
# configuration; it adds no commands and takes no other privileges.
set -euo pipefail

PREFIX=${NIMVOR_PREFIX:-/opt/nimvor}
CONF=${NIMVOR_CONF:-/etc/nimvor/panel.php}
UNIT=${NIMVOR_PANEL_UNIT:-/etc/systemd/system/nimvor-panel.service}
ACCOUNT=nimvor

[[ -f $PREFIX/panel/bin/nimvor ]] || { echo "NimVor is not installed in $PREFIX." >&2; exit 1; }

# Not root and not the panel account: ask sudo to run this same command.
if [[ $(id -u) -ne 0 && $(id -un) != "$ACCOUNT" ]]; then
    exec sudo "$0" "$@"
fi

# The PHP the panel itself runs with (Ubuntu 22.04: PHP 8.3 next to the system's 8.1).
php=$(grep -oE '^ExecStart=[^ ]+' "$UNIT" 2>/dev/null | head -1 | cut -d= -f2 || true)
[[ -n $php && -x $php ]] || php=$(command -v php || echo /usr/bin/php)

cmd=${1:-help}
[[ $# -gt 0 ]] && shift
case $cmd in
    reset-password|passwd) cmd=user:password ;;
    reset-2fa) cmd=user:2fa-reset ;;
esac

# ---- nimvor update --------------------------------------------------------
# Brings the installation to the newest release from any older one: fetches the
# release, runs the installer's own reinstall (dependencies, agent, panel files,
# database migrations, services), keeping the configuration. Works whether the
# source checkout is on a branch, pinned to a release or has no local "main".
update_usage() {
    cat <<'TXT'
Usage: sudo nimvor update [--check] [--version X.Y.Z | --branch NAME]

  (no option)        update to the newest stable release
  --check            only say whether a newer release exists
  --version X.Y.Z    install that release (an older one needs --allow-downgrade)
  --branch NAME      follow a branch (development, for example: --branch main)
  --allow-downgrade  allow going back to an older release
TXT
}

update_main() {
    local check=0 want_version= want_branch= downgrade=0
    while (($#)); do
        case $1 in
            --check) check=1 ;;
            --version) want_version=${2:?--version needs a value}; shift ;;
            --branch) want_branch=${2:?--branch needs a value}; shift ;;
            --allow-downgrade) downgrade=1 ;;
            -h|--help|help) update_usage; return 0 ;;
            *) echo "nimvor update: unknown option $1" >&2; update_usage >&2; return 2 ;;
        esac
        shift
    done
    [[ -z $want_version || -z $want_branch ]] || { echo "Use either --version or --branch, not both." >&2; return 2; }
    [[ -z $want_version || $want_version =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || { echo "--version: use a version like 1.9.0" >&2; return 2; }
    [[ -z $want_branch || ( $want_branch =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ && $want_branch != *..* ) ]] || { echo "--branch: not a valid branch name." >&2; return 2; }
    [[ $(id -u) -eq 0 ]] || { echo "Run it as root: sudo nimvor update" >&2; return 1; }
    command -v git >/dev/null || { echo "git is not installed." >&2; return 1; }

    local src= cand
    for cand in "${NIMVOR_SRC:-}" "$(cat "$(dirname "$CONF")/source" 2>/dev/null || true)" /usr/local/src/nimvor; do
        [[ -n $cand && -d $cand/.git && -x $cand/installer/install.sh ]] && { src=$cand; break; }
    done
    [[ -n $src ]] || { echo "Cannot find the NimVor source checkout (looked in /etc/nimvor/source and /usr/local/src/nimvor). Install again with: curl -fsSL https://nimvor.com/install | sudo bash" >&2; return 1; }

    local owner
    owner=$(stat -c %U "$src")
    as_owner() { if [[ $owner == root ]]; then "$@"; else runuser -u "$owner" -- "$@"; fi; }
    local say=$'\033[1;36m==>\033[0m'

    local installed=
    installed=$(tr -d ' \n' <"$PREFIX/panel/VERSION" 2>/dev/null || true)
    [[ -n $installed ]] || installed=$(tr -d ' \n' <"$src/VERSION" 2>/dev/null || true)

    local ref= kind=tag
    if [[ -n $want_branch ]]; then
        kind=branch ref=$want_branch
    elif [[ -n $want_version ]]; then
        ref=v${want_version#v}
    else
        local tags
        tags=$(as_owner git -C "$src" ls-remote --tags --refs origin 'v[0-9]*' 2>/dev/null | awk '{sub("refs/tags/","",$2); print $2}') || tags=
        ref=$(grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' <<<"$tags" | sort -V | tail -n1 || true)
        [[ -n $ref ]] || { echo "Could not find a published release (network problem, or none exists yet). Try again later, or follow development with: sudo nimvor update --branch main" >&2; return 1; }
    fi

    if [[ $kind == tag ]]; then
        local target=${ref#v}
        echo "Installed: ${installed:-unknown}    Newest release: $target"
        if [[ -n $installed && $installed == "$target" ]]; then
            echo "NimVor is up to date."
            return 0
        fi
        if [[ -n $installed && $(printf '%s\n%s\n' "$installed" "$target" | sort -V | tail -n1) == "$installed" ]]; then
            if [[ -z $want_version ]]; then
                echo "This installation ($installed) is newer than the newest release: a development build. Nothing to do."
                return 0
            elif ((!downgrade)); then
                echo "$target is older than the installed $installed. Add --allow-downgrade to go back." >&2
                return 1
            fi
        fi
        ((!check)) || { echo "A newer release is available: run  sudo nimvor update"; return 0; }
    else
        echo "Installed: ${installed:-unknown}    Following branch: $ref (development)"
        ((!check)) || return 0
    fi

    if [[ $owner != root && -n $(find "$src" ! -user "$owner" -print -quit 2>/dev/null) ]]; then
        chown -R "$owner": "$src"
    fi
    local changes
    changes=$(as_owner git -C "$src" status --porcelain --untracked-files=no) || { echo "git cannot read $src as $owner." >&2; return 1; }
    if [[ -n $changes ]]; then
        as_owner git -C "$src" status --short --untracked-files=no >&2
        echo "The source checkout has local changes (above). Undo them (git -C $src stash) and run this again." >&2
        return 1
    fi

    echo "$say Fetching $ref"
    if [[ $kind == tag ]]; then
        as_owner git -C "$src" fetch --quiet --depth 50 --no-recurse-submodules origin "+refs/tags/$ref:refs/tags/$ref" || { echo "Could not fetch $ref (network problem, or no such release). Nothing was changed." >&2; return 1; }
        as_owner git -C "$src" -c advice.detachedHead=false checkout --quiet --detach "refs/tags/$ref^{commit}" || { echo "Could not switch to $ref. Nothing was changed." >&2; return 1; }
    else
        as_owner git -C "$src" fetch --quiet --depth 50 --no-recurse-submodules origin "+refs/heads/$ref:refs/remotes/origin/$ref" || { echo "Could not fetch the branch $ref. Nothing was changed." >&2; return 1; }
        as_owner git -C "$src" checkout --quiet -B "$ref" "refs/remotes/origin/$ref" || { echo "Could not switch to $ref. Nothing was changed." >&2; return 1; }
        as_owner git -C "$src" branch --quiet --set-upstream-to="origin/$ref" "$ref" || true
    fi
    echo "$say Updating NimVor to $(tr -d ' \n' <"$src/VERSION" 2>/dev/null || echo "$ref") (database migrations run as part of it)"
    exec "$src/installer/install.sh" --reinstall --yes
}

if [[ $cmd == update ]]; then
    update_main "$@"
    exit $?
fi

run=("$php" "$PREFIX/panel/bin/nimvor" "$cmd" "$@")
if [[ $(id -un) == "$ACCOUNT" ]]; then
    exec env NIMVOR_CONFIG="$CONF" "${run[@]}"
fi
exec runuser -u "$ACCOUNT" -- env NIMVOR_CONFIG="$CONF" "${run[@]}"
