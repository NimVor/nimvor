[Unit]
Description=NimVor panel (loopback web interface)
Documentation=https://github.com/NimVor/nimvor/tree/main/docs/installation
After=network.target nimvor-agent.service
Wants=nimvor-agent.service

[Service]
Type=simple
User=nimvor
Group=nimvor
Environment=NIMVOR_CONFIG=/etc/nimvor/panel.php
Environment=PHP_CLI_SERVER_WORKERS=4
# Bound to loopback only. Reach it through an SSH tunnel, or put a TLS
# reverse proxy in front (see docs/installation/README.md).
ExecStart=/usr/bin/php -d display_errors=0 -d expose_php=0 -S 127.0.0.1:8090 -t /opt/nimvor/panel/public /opt/nimvor/panel/public/router.php
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nimvor /var/log/nimvor
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
MemoryMax=512M

[Install]
WantedBy=multi-user.target
